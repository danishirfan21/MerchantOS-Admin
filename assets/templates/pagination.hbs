<span>Showing <strong>{{pager.start}}–{{pager.end}}</strong> of <strong>{{pager.total}}</strong> products</span><nav aria-label="Results pages"><ul class="pagination mb-0">{{#each links}}<li class="page-item {{#if disabled}}disabled{{/if}} {{#if current}}active{{/if}}">{{#if disabled}}<span class="page-link" aria-disabled="true">{{label}}</span>{{else}}<a class="page-link" href="{{url}}" {{#if current}}aria-current="page"{{/if}}>{{label}}</a>{{/if}}</li>{{/each}}</ul></nav>
