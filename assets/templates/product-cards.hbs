{{#each products}}<article class="mobile-product-card {{#if ../inventory}}mobile-inventory-card{{/if}}"><div class="mobile-product-identity"><img src="{{imageUrl}}" alt="" width="56" height="56"><div><div class="mobile-card-topline"><span>{{category}}</span><span class="stock-badge {{statusClass}}">{{stockStatus}}</span></div><h2><a class="product-detail-link" href="{{detailUrl}}">{{name}}</a></h2><p>{{sku}}</p></div></div><div class="mobile-product-footer">{{#unless ../inventory}}<div><small>Price (SAR)</small><strong class="mobile-price">{{price}}</strong></div>{{/unless}}<div class="mobile-available"><small>{{#if ../inventory}}Available quantity{{else}}Available{{/if}}</small><strong>{{stock}} units</strong>{{#if ../inventory}}<small>Demo threshold: 5 units</small>{{/if}}</div><a class="product-detail-link mobile-detail" href="{{detailUrl}}" aria-label="View details for {{name}}"><span>{{#if ../inventory}}View Details{{else}}Details{{/if}}</span><span class="icon" aria-hidden="true">chevron_right</span></a></div></article>{{else}}<div class="empty"><h3>No products found</h3><p>Try a different search or clear your filters.</p></div>{{/each}}
