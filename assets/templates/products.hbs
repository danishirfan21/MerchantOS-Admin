{{#each products}}<tr><td><div class="product-cell"><img class="product-thumb" src="{{imageUrl}}" alt="" width="40" height="40"><div><strong>{{name}}</strong><small>{{category}} · {{sku}}</small></div></div></td><td class="sku">{{sku}}</td><td><span class="category-badge">{{category}}</span></td><td class="text-end money {{#if ../inventory}}stock-quantity{{/if}}">{{#if ../inventory}}{{stock}}{{else}}{{price}}{{/if}}</td><td class="text-end">{{#if ../inventory}}Min 5 (demo){{else}}{{stock}} units{{/if}}</td><td class="text-center"><span class="stock-badge {{statusClass}}"><span class="status-dot"></span>{{stockStatus}}</span></td><td class="text-end"><a class="product-detail-link row-action" href="{{detailUrl}}">View Details <span class="icon" aria-hidden="true">chevron_right</span></a></td></tr>{{else}}<tr><td colspan="7" class="empty"><h3>No products found</h3><p>Try a different search or clear your filters.</p></td></tr>{{/each}}
