{{#each products}}<tr><td><strong>{{name}}</strong></td><td class="sku">{{sku}}</td><td>{{category}}</td><td class="money">{{price}}</td><td>{{stock}}</td><td><span class="stock-badge {{statusClass}}">{{stockStatus}}</span></td><td><a href="{{detailUrl}}">View<span class="visually-hidden"> {{name}}</span></a></td></tr>{{else}}<tr><td colspan="7" class="empty"><h3>No products found</h3><p>Try a different search or clear your filters.</p></td></tr>{{/each}}
