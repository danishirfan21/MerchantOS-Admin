@model ReportFilters
<div class="report-range"><label for="range">Date range (Asia/Riyadh)</label><select class="form-select" id="range" name="range">@if(ViewData["AllowAll"] as bool? ==true){<option value="all" selected="@(string.IsNullOrEmpty(Model.Range)||Model.Range=="all")">All history</option>}<option value="today" selected="@(Model.Range=="today")">Today</option><option value="yesterday" selected="@(Model.Range=="yesterday")">Yesterday</option><option value="week" selected="@(Model.Range=="week")">Last 7 Days</option><option value="month" selected="@(Model.Range=="month")">Last 30 Days</option><option value="custom" selected="@(Model.Range=="custom")">Custom Range</option></select></div>
<div class="custom-report-date"><label for="from">From (store date)</label><input class="form-control" id="from" name="from" type="date" value="@Model.From" min="2000-01-01" disabled="@(Model.Range!="custom")" required></div><div class="custom-report-date"><label for="to">Through (store date)</label><input class="form-control" id="to" name="to" type="date" value="@Model.To" min="2000-01-01" disabled="@(Model.Range!="custom")" required></div>
