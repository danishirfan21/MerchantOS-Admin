@model CatalogVm
<div class="metric-grid catalog-metrics">
<div class="metric"><div><span>@(Model.Inventory ? "Total Stock on Hand" : "Active Catalog")</span><strong>@(Model.Error is null ? (Model.Inventory ? Model.TotalUnits : Model.TotalProducts).ToString("N0") : "—") <small>@(Model.Inventory ? "units" : "SKUs")</small></strong><p>@(Model.Inventory ? $"Across {Model.TotalProducts} catalog SKUs" : "Current product catalog")</p></div><span class="metric-icon neutral"><span class="icon" aria-hidden="true">inventory_2</span></span></div>
<div class="metric"><div><span>@(Model.Inventory ? "Healthy Stock Levels" : "In Stock (Healthy Stock)")</span><strong>@(Model.Error is null ? Model.HealthyStock.ToString() : "—") <small>@(Model.Inventory ? "products" : "Items")</small></strong><p>Above demo threshold</p></div><span class="metric-icon"><span class="icon" aria-hidden="true">check_circle</span></span></div>
<div class="metric"><div><span class="desktop-stock-value">@(Model.Inventory ? "Below Reorder Threshold" : "Low Stock")</span><span class="tablet-stock-value">Restock Attention</span><strong class="desktop-stock-value">@(Model.Error is null ? Model.LowStock.ToString() : "—") <small>@(Model.Inventory ? "products" : "Items")</small></strong><strong class="tablet-stock-value">@(Model.Error is null ? (Model.LowStock + Model.OutOfStock).ToString() : "—") <small>Items</small></strong><p>1–5 units remaining</p></div><span class="metric-icon caution"><span class="icon" aria-hidden="true">warning</span></span></div>
<div class="metric"><div><span>@(Model.Inventory ? "Zero Available" : "Out of Stock")</span><strong>@(Model.Error is null ? Model.OutOfStock.ToString() : "—") <small>@(Model.Inventory ? "products" : "Items")</small></strong><p>Depleted stock</p></div><span class="metric-icon danger"><span class="icon" aria-hidden="true">error_outline</span></span></div>
</div>
