@model List<OrderDto>
<div class="table-responsive"><table class="table admin-table orders-table"><thead><tr><th>Order Number</th><th>Date &amp; Time (UTC)</th><th>Items</th><th>Payment Method</th><th class="text-end">Total (SAR)</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody>
@foreach(var order in Model) { <tr><td><a asp-action="Order" asp-route-id="@order.Id">#@order.OrderNumber</a></td><td><time datetime="@order.CreatedAt.ToUniversalTime().ToString("O")">@order.CreatedAt.ToUniversalTime().ToString("dd MMM yyyy · HH:mm")</time></td><td><span class="muted" title="The POS order-list endpoint does not include item counts">@(order.Items is null ? "View receipt" : $"{order.Items.Count} items")</span></td><td><span class="payment-label"><span class="icon" aria-hidden="true">@(order.PaymentMethod == "card" ? "credit_card" : "payments")</span>@Display.Payment(order.PaymentMethod)</span></td><td class="text-end money">@Display.Money(order.PayableHalalas, order.Currency)<small class="tablet-payment">@Display.Payment(order.PaymentMethod)</small></td><td><span class="stock-badge success">@order.Status</span></td><td class="text-end"><a class="row-action" asp-action="Order" asp-route-id="@order.Id">View Details <span class="icon" aria-hidden="true">arrow_forward</span></a></td></tr> }
</tbody></table></div>
