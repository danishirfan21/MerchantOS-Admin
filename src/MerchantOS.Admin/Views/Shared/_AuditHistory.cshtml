@model HistoryVm
@functions {
 static string ActionLabel(string action)=>action switch {"product.updated"=>"Product updated","inventory.restock"=>"Stock restocked","inventory.damage"=>"Damage or loss recorded","inventory.correction"=>"Stock corrected",_=>"Administrative change"};
 static string FieldLabel(string field)=>field switch {"name"=>"Product name","nameAr"=>"Arabic name","category"=>"Category","priceHalalas"=>"Selling price","stock"=>"Available stock",_=>field};
 static IEnumerable<System.Text.Json.JsonProperty> Fields(System.Text.Json.JsonElement values)=>values.EnumerateObject().Where(p=>p.Name is "name" or "nameAr" or "category" or "priceHalalas" or "stock");
 static string Value(System.Text.Json.JsonProperty field)=>field.Name=="priceHalalas"?Display.Money(field.Value.GetInt64()):field.Value.ToString();
}
<h2 tabindex="-1" class="management-title">Audit History</h2><p>Recorded administrative changes · UTC</p>
@if(Model.History.Items.Count==0){<p>No administrative changes recorded.</p>}
<div class="audit-list">@foreach(var entry in Model.History.Items){<article class="audit-entry"><h3>@ActionLabel(entry.Action)</h3><p><time>@entry.Timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</time> · @entry.Administrator</p><dl><div><dt>Previous values</dt><dd>@foreach(var field in Fields(entry.PreviousValues)){<p><strong>@FieldLabel(field.Name):</strong> @Value(field)</p>}</dd></div><div><dt>New values</dt><dd>@foreach(var field in Fields(entry.NewValues)){<p><strong>@FieldLabel(field.Name):</strong> @Value(field)</p>}</dd></div></dl>@if(entry.Reason is not null){<p><strong>Reason:</strong> @entry.Reason</p>}</article>}</div>
<nav aria-label="Audit pages" class="management-actions">@if(Model.History.Page>1){<button class="btn btn-light management-open" data-url="@Url.Action("History","Management",new{id=Model.ProductId,page=Model.History.Page-1})">Previous history</button>}<span>Page @Model.History.Page</span>@if(Model.History.HasMore){<button class="btn btn-light management-open" data-url="@Url.Action("History","Management",new{id=Model.ProductId,page=Model.History.Page+1})">Next history</button>}</nav><button type="button" class="btn btn-light management-cancel" data-product-id="@Model.ProductId">Back to details</button>
