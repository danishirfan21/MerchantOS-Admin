@model ProductDto
<div class="product-summary"><img src="@Display.Thumbnail(Model.Id, Model.Category)" alt="" width="120" height="120"><span class="category-badge">@Model.Category</span><h2>@Model.Name</h2><p>@Model.NameAr</p><strong>@Display.Money(Model.PriceHalalas)</strong><span class="sku">@Model.Sku</span></div>
<h3 class="section-label">Current Store Inventory</h3><dl class="drawer-details"><div><dt>Available quantity</dt><dd>@Model.Stock units</dd></div><div><dt>Status</dt><dd>@Display.StockStatus(Model.Stock)</dd></div><div><dt>Demo reorder threshold</dt><dd>5 units</dd></div></dl><p class="muted">Read-only POS record. Current catalog price; historical receipt prices are retained at checkout.</p>
