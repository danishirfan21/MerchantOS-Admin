@model OrderDto
@{ ViewData["Title"] = "Orders"; ViewData["PageClass"] = "receipt-page"; ViewData["BreadcrumbDetail"] = Model.OrderNumber; var items = Model.Items ?? []; }
<section class="panel receipt-header"><a class="back-link" asp-action="Orders"><span class="icon" aria-hidden="true">arrow_back</span>Back to Orders</a>
<div class="page-heading order-heading"><div><h1>Order #@Model.OrderNumber</h1><div class="order-meta"><span class="stock-badge success">@Model.Status</span><span class="meta-divider"></span><span class="icon" aria-hidden="true">schedule</span><time datetime="@Model.CreatedAt.ToUniversalTime().ToString("O")">@Model.CreatedAt.ToUniversalTime().ToString("dd MMMM yyyy 'at' HH:mm") UTC</time></div></div><button class="btn btn-emerald print-receipt" type="button"><span class="icon" aria-hidden="true">print</span>Print Receipt</button></div></section>
<div class="receipt-grid"><section class="panel purchased-items"><div class="panel-heading"><h2><span class="icon" aria-hidden="true">shopping_bag</span>Purchased Items <span class="count-chip">@items.Count items</span></h2><span class="muted">All prices in @Model.Currency</span></div><div class="table-responsive"><table class="table admin-table receipt-table"><thead><tr><th>Item</th><th class="text-end">Unit Price (Excl. VAT)</th><th class="text-center">Qty</th><th class="text-end">Line Total</th></tr></thead><tbody>
@foreach(var item in items) { <tr><td><div class="product-cell"><img class="product-thumb" src="@Display.Thumbnail(item.ProductId)" alt="" width="56" height="56"><div><strong>@item.Name</strong><small class="sku-chip">SKU: @item.Sku</small></div></div></td><td class="text-end money">@Display.Money(item.UnitPriceHalalas, Model.Currency)</td><td class="text-center"><span class="quantity-chip">@item.Quantity</span></td><td class="text-end money line-total">@Display.Money(checked(item.UnitPriceHalalas * item.Quantity), Model.Currency)</td></tr> }
</tbody></table></div><div class="receipt-items-footer"><span><span class="icon" aria-hidden="true">check_circle</span>@items.Count line items recorded</span><span>Total Units: @items.Sum(i=>i.Quantity)</span></div></section>
<section class="panel financial-summary"><div class="financial-heading"><h2>Financial Summary</h2><span class="count-chip">@Model.Currency</span></div><dl class="receipt-totals"><div><dt>Subtotal (Excl. VAT)</dt><dd>@Display.Money(Model.SubtotalHalalas, Model.Currency)</dd></div><div class="discount"><dt>Discount</dt><dd>−@Display.Money(Model.DiscountHalalas, Model.Currency)</dd></div><div><dt>Net Taxable Amount</dt><dd>@Display.Money(Model.SubtotalHalalas - Model.DiscountHalalas, Model.Currency)</dd></div><div><dt>VAT (15%)</dt><dd>@Display.Money(Model.VatHalalas, Model.Currency)</dd></div></dl><div class="grand-total"><span>Grand Total (Incl. VAT)</span><strong>@Display.Money(Model.PayableHalalas, Model.Currency)</strong></div>
<h3 class="section-label">Payment Method</h3><div class="payment-card"><span class="icon" aria-hidden="true">@(Model.PaymentMethod=="card" ? "credit_card" : "payments")</span><div><strong>@Display.Payment(Model.PaymentMethod)</strong><small>@(Model.PaymentMethod=="card" ? "Demo payment simulation" : "Cash at checkout")</small></div><span class="stock-badge success">@Model.Status</span></div>@if(Model.PaymentMethod=="cash") { <div class="change-line"><span>Change returned</span><strong>@Display.Money(Model.ChangeHalalas, Model.Currency)</strong></div> }
</section></div><p class="data-scope receipt-note">Read-only receipt from MerchantOS POS. All monetary values reflect the persisted checkout record.</p>
