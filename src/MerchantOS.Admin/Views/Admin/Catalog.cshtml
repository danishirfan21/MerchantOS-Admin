@model CatalogVm
@{ ViewData["Title"] = Model.Inventory ? "Inventory" : "Products"; }
<div class="page-heading"><div><p class="eyebrow">@(Model.Inventory ? "STOCK CONTROL" : "PRODUCT DIRECTORY")</p><h1>@(Model.Inventory ? "Inventory overview" : "Product catalog")</h1><p>@(Model.Inventory ? "Keep track of stock levels across your store." : "Explore your catalog, pricing and availability.")</p></div><span class="read-only">Read only</span></div>
@if(Model.Inventory) { <div class="metric-grid"><div class="metric"><span>Products</span><strong>@(Model.Error is null ? Model.TotalProducts.ToString() : "—")</strong></div><div class="metric"><span>Units on hand</span><strong>@(Model.Error is null ? Model.TotalUnits.ToString("N0") : "—")</strong></div><div class="metric"><span>Low stock · 1–5</span><strong>@(Model.Error is null ? Model.LowStock.ToString() : "—")</strong></div><div class="metric"><span>Out of stock</span><strong>@(Model.Error is null ? Model.OutOfStock.ToString() : "—")</strong></div></div> }
<section class="panel"><div class="panel-heading"><div><h2>@(Model.Inventory ? "Stock levels" : "All products")</h2><p>Prices in SAR · low stock means 1–5 units</p></div><span class="record-count">@Model.Products.Count results</span></div>
<form method="get" class="filter-bar" id="catalog-filters" data-endpoint="@Url.Action("ProductRows")">
<div class="search-field"><label for="search">Search products</label><input class="form-control" id="search" name="search" maxlength="120" value="@Model.Search" placeholder="Product name or SKU"></div>
<div><label for="category">Category</label><select class="form-select" id="category" name="category"><option value="">All categories</option>@foreach(var category in Model.Categories) { <option value="@category" selected="@(category == Model.Category)">@category</option> }</select></div>
<div><label for="stock">Availability</label><select class="form-select" id="stock" name="stock"><option value="">All stock</option><option value="available" selected="@(Model.Stock == "available")">In stock (6+)</option><option value="low" selected="@(Model.Stock == "low")">Low stock (1–5)</option><option value="out" selected="@(Model.Stock == "out")">Out of stock</option></select></div><button class="btn btn-emerald" type="submit">Apply filters</button><a class="btn btn-light" href="@Url.Action(Model.Inventory ? "Inventory" : "Products")">Reset</a></form>
<p id="filter-status" class="filter-status" role="status" aria-live="polite"></p>
@if(Model.Error is not null) { <partial name="_ErrorNotice" model="Model.Error" /> }
<div class="table-responsive"><table class="table admin-table"><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Unit price</th><th>Stock</th><th>Availability</th><th><span class="visually-hidden">Details</span></th></tr></thead><tbody id="product-rows">
@foreach(var product in Model.Products) { <tr><td><strong>@product.Name</strong></td><td class="sku">@product.Sku</td><td>@product.Category</td><td class="money">@product.Price</td><td>@product.Stock</td><td><span class="stock-badge @product.StatusClass">@product.StockStatus</span></td><td><a asp-action="Product" asp-route-id="@product.Id">View<span class="visually-hidden"> @product.Name</span></a></td></tr> }
@if(Model.Products.Count == 0 && Model.Error is null) { <tr><td colspan="7" class="empty"><h3>No products found</h3><p>Try a different search or clear your filters.</p></td></tr> }
</tbody></table></div><div class="panel-bottom">Live POS inventory · stock may change while you browse.</div></section>
