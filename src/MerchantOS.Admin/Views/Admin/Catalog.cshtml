@model CatalogVm
@{ ViewData["Title"] = Model.Inventory ? "Inventory" : "Products"; ViewData["PageClass"] = Model.Inventory ? "inventory-page" : "catalog-page"; }
<div class="page-heading"><div><div class="heading-with-count"><h1>@(Model.Inventory ? "Inventory" : "Products")</h1>@if(!Model.Inventory && Model.Error is null) { <span class="count-chip">@Model.TotalProducts Products</span> }</div><p>@(Model.Inventory ? "Monitor stock levels and identify products requiring reorders." : "Manage your electronics catalog, pricing, and available stock.")</p></div></div>
<partial name="_StockCards" model="Model" />
@if(Model.Inventory && Model.Error is null) { <section class="attention-banner"><span class="attention-symbol"><span class="icon" aria-hidden="true">notification_important</span></span><div><h2>@(Model.LowStock + Model.OutOfStock) products require attention</h2><p>Stock is low or depleted. Demo reorder threshold: 5 units for every product.</p></div><a class="btn btn-white" asp-action="Inventory" asp-route-stock="attention"><span class="icon" aria-hidden="true">filter_list</span>Filter Low / Depleted</a></section> }
<section class="panel catalog-panel"><form method="get" class="filter-bar" id="catalog-filters" data-endpoint="@Url.Action("ProductRows")" data-inventory="@Model.Inventory.ToString().ToLowerInvariant()">
<div class="search-field"><label class="visually-hidden" for="search">Search products</label><span class="icon" aria-hidden="true">search</span><input class="form-control" id="search" name="search" maxlength="120" value="@Model.Search" placeholder="Search product name or SKU..."></div>
<div><label class="visually-hidden" for="category">Category</label><select class="form-select" id="category" name="category"><option value="">All Categories</option>@foreach(var category in Model.Categories) { <option value="@category" selected="@(category == Model.Category)">@category</option> }</select></div>
<div><label class="visually-hidden" for="stock">Availability</label><select class="form-select" id="stock" name="stock"><option value="">All Stock Statuses</option><option value="available" selected="@(Model.Stock == "available")">In Stock (6+)</option><option value="low" selected="@(Model.Stock == "low")">Low Stock (1–5)</option><option value="out" selected="@(Model.Stock == "out")">Out of Stock</option><option value="attention" selected="@(Model.Stock == "attention")">Low / Depleted</option></select></div>
<div class="mobile-extra-filter"><label class="visually-hidden" for="sort">Sort products</label><select class="form-select" id="sort" name="sort"><option value="name" selected="@(Model.Sort=="name")">Alphabetical (A–Z)</option><option value="price-desc" selected="@(Model.Sort=="price-desc")">Price: High to Low</option><option value="price-asc" selected="@(Model.Sort=="price-asc")">Price: Low to High</option><option value="stock-desc" selected="@(Model.Sort=="stock-desc")">Stock: High to Low</option></select></div>
<button class="btn btn-emerald apply-filters mobile-extra-filter" type="submit">Apply filters</button><a class="btn btn-light reset-button mobile-extra-filter" href="@Url.Action(Model.Inventory ? "Inventory" : "Products")" aria-label="Reset filters" title="Reset filters"><span class="icon" aria-hidden="true">restart_alt</span></a><button class="btn mobile-filter-toggle" id="mobile-filter-toggle" type="button" aria-expanded="false">More filters &amp; sorting</button></form>
<p id="filter-status" class="filter-status" role="status" aria-live="polite"></p>
@if(Model.Error is not null) { <partial name="_ErrorNotice" model="Model.Error" /> }
<div class="table-responsive"><table class="table admin-table catalog-table @(Model.Inventory ? "inventory-table" : "")"><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th class="text-end">@(Model.Inventory ? "Quantity Available" : "Price (SAR)")</th><th class="text-end">@(Model.Inventory ? "Reorder Threshold" : "Available Stock")</th><th class="text-center">Status</th><th class="text-end">Action</th></tr></thead><tbody id="product-rows">
@foreach(var product in Model.Products) { <tr><td><div class="product-cell"><img class="product-thumb" src="@product.ImageUrl" alt="" width="40" height="40"><div><a class="product-name-link product-detail-link" href="@Url.Action("Product", new { id = product.Id })"><strong>@product.Name</strong></a><small>@product.Category · @product.Sku</small></div></div></td><td class="sku">@product.Sku</td><td><span class="category-badge">@product.Category</span></td><td class="text-end money @(Model.Inventory ? "stock-quantity" : "")">@(Model.Inventory ? product.Stock.ToString() : product.Price)</td><td class="text-end">@(Model.Inventory ? "Min 5 (demo)" : $"{product.Stock} units")</td><td class="text-center"><span class="stock-badge @product.StatusClass"><span class="status-dot"></span>@product.StockStatus</span></td><td class="text-end"><a class="product-detail-link row-action" asp-action="Product" asp-route-id="@product.Id">View Details <span class="icon" aria-hidden="true">chevron_right</span></a></td></tr> }
@if(Model.Products.Count == 0 && Model.Error is null) { <tr><td colspan="7" class="empty"><h3>No products found</h3><p>Try a different search or clear your filters.</p></td></tr> }
</tbody></table></div><partial name="_MobileProductCards" model="Model" /><partial name="_Pagination" model="Model.Pager" /></section>
