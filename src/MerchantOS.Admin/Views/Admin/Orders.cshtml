@model OrdersVm
@{ ViewData["Title"] = "Orders"; ViewData["PageClass"] = "orders-page"; }
<div class="page-heading"><div><div class="heading-with-count"><h1>Orders</h1>@if(Model.Error is null) { <span class="count-chip">@Model.WindowCount Matching Orders</span> }</div><p>View and track completed retail POS transactions.</p></div></div>
<section class="panel orders-panel"><form method="get" class="filter-bar order-filters report-form"><div class="search-field"><label class="visually-hidden" for="search">Order number</label><span class="icon" aria-hidden="true">search</span><input class="form-control" id="search" name="search" value="@Model.Search" maxlength="120" placeholder="Search by order number (e.g. MOS-A1B2C3D4E5F6)..."></div>@{ViewData["AllowAll"]=true;}<partial name="_ReportRange" model="Model.Filters" /><div><label class="visually-hidden" for="payment">Payment method</label><select class="form-select" id="payment" name="payment"><option value="">All Payment Methods</option><option value="card" selected="@(Model.Payment=="card")">Simulated Card</option><option value="cash" selected="@(Model.Payment=="cash")">Cash</option></select></div><div><label for="status">Order status</label><select class="form-select" name="status" id="status"><option value="">All statuses</option>@foreach(var status in new[]{"completed","cancelled","failed"}){<option selected="@(Model.Filters.Status==status)">@status</option>}</select></div><button class="btn btn-emerald" type="submit">Search</button><a class="reset-text" asp-action="Orders"><span class="icon" aria-hidden="true">restart_alt</span>Reset filters</a></form><a class="btn btn-light csv-export" href="@Model.Filters.ExportUrl()">Export CSV</a><p class="report-period">Asia/Riyadh · @(Model.Filters.Range is null or "all" ? "All historical dates" : Model.Period is not null ? $"{Model.Period.From:dd MMM yyyy} – {Model.Period.To:dd MMM yyyy} (inclusive)" : "Selected store-local period")</p>
@if(Model.Error is not null) { <partial name="_ErrorNotice" model="Model.Error" /> }
else if(Model.Orders.Count == 0) { <div class="empty"><h3>No orders found</h3><p>Sales completed in the POS appear here. Try clearing your search.</p></div> }
else { <partial name="_OrderTable" model="Model.Orders" /> }
@if(Model.Error is null && Model.Orders.Count>0){<partial name="_Pagination" model="Model.Pager" />}</section><p class="data-scope">Complete history is filtered and paginated on the server. Asia/Riyadh date filters apply to export too. Exports are limited to 10,000 rows; narrow filters for larger periods. Item details remain inside each receipt.</p>
