@model OrdersVm
@{ ViewData["Title"] = "Orders"; ViewData["PageClass"] = "orders-page"; }
<div class="page-heading"><div><div class="heading-with-count"><h1>Orders</h1>@if(Model.Error is null) { <span class="count-chip">@Model.WindowCount Orders in Window</span> }</div><p>View and track completed retail POS transactions.</p></div></div>
<section class="panel orders-panel"><form method="get" class="filter-bar order-filters"><div class="search-field"><label class="visually-hidden" for="search">Order number</label><span class="icon" aria-hidden="true">search</span><input class="form-control" id="search" name="search" value="@Model.Search" maxlength="120" placeholder="Search by order number (e.g. MOS-A1B2C3D4E5F6)..."></div><div><label class="visually-hidden" for="range">Date range (UTC)</label><select class="form-select" id="range" name="range"><option value="">All Dates in Window</option><option value="today" selected="@(Model.Range=="today")">Today (UTC)</option><option value="yesterday" selected="@(Model.Range=="yesterday")">Yesterday (UTC)</option><option value="week" selected="@(Model.Range=="week")">Last 7 Days (UTC)</option></select></div><div><label class="visually-hidden" for="payment">Payment method</label><select class="form-select" id="payment" name="payment"><option value="">All Payment Methods</option><option value="card" selected="@(Model.Payment=="card")">Simulated Card</option><option value="cash" selected="@(Model.Payment=="cash")">Cash</option></select></div><button class="btn btn-emerald" type="submit">Search</button><a class="reset-text" asp-action="Orders"><span class="icon" aria-hidden="true">restart_alt</span>Reset filters</a></form>
@if(Model.Error is not null) { <partial name="_ErrorNotice" model="Model.Error" /> }
else if(Model.Orders.Count == 0) { <div class="empty"><h3>No orders found</h3><p>Sales completed in the POS appear here. Try clearing your search.</p></div> }
else { <partial name="_OrderTable" model="Model.Orders" /> }
<partial name="_Pagination" model="Model.Pager" /></section><p class="data-scope">Search, date filters and pagination apply to the latest 100 orders returned by the POS. Item counts are available inside each receipt.</p>
