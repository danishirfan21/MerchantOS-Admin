@model DashboardVm
@{ ViewData["Title"] = "Overview"; var report=Model.Report; var buckets=report?.Trend??[]; var max=Math.Max(1,buckets.Select(b=>b.RevenueHalalas).DefaultIfEmpty().Max()); }
<div class="page-heading"><div><h1>Overview</h1><p>Monitor your store operations, sales, and inventory at a glance.</p></div></div>
<form method="get" class="report-toolbar report-form"><partial name="_ReportRange" model="Model.Filters" /><button class="btn btn-emerald" type="submit">Apply period</button></form>
<p class="report-period">@(report is null ? "Report unavailable" : $"{report.Period.From:dd MMM yyyy} – {report.Period.To:dd MMM yyyy} · Asia/Riyadh · inclusive store dates")</p>
<div class="metric-grid dashboard-metrics">
<div class="metric"><div class="metric-top"><span>Sales revenue</span><span class="metric-icon"><span class="icon" aria-hidden="true">payments</span></span></div><strong>@(Model.Orders.Error is null ? Display.Money(Model.SalesHalalas) : "Unavailable")</strong><p>Completed SAR sales · includes VAT</p></div>
<div class="metric"><div class="metric-top"><span>Orders Completed</span><span class="metric-icon"><span class="icon" aria-hidden="true">check_circle</span></span></div><strong>@(Model.Orders.Error is null ? Model.CompletedOrders.ToString() : "Unavailable")</strong><p>Selected store-local period</p></div>
<div class="metric"><div class="metric-top"><span>Active Products</span><span class="metric-icon neutral"><span class="icon" aria-hidden="true">inventory_2</span></span></div><strong>@(Model.Catalog.Error is null ? Model.Catalog.TotalProducts.ToString() : "Unavailable")</strong><p>@(Model.Catalog.Error is null ? $"{Model.Catalog.TotalProducts} SKUs · current snapshot" : "POS catalog unavailable")</p></div>
<div class="metric"><div class="metric-top"><span>Low Stock Products</span><span class="metric-icon danger"><span class="icon" aria-hidden="true">warning</span></span></div><strong class="text-danger">@(Model.Catalog.Error is null ? Model.Catalog.LowStock.ToString() : "Unavailable")</strong><p>@(Model.Catalog.Error is null ? "Current snapshot · 1–5 units" : "POS inventory unavailable")</p></div>
</div>
@if(report is not null){<section class="panel financial-strip" aria-label="Sales calculation"><dl><div><dt>Gross before discount / VAT</dt><dd>@Display.Money(report.Summary.GrossHalalas)</dd></div><div><dt>Discounts</dt><dd>@Display.Money(report.Summary.DiscountsHalalas)</dd></div><div><dt>Net before VAT</dt><dd>@Display.Money(report.Summary.NetBeforeVatHalalas)</dd></div><div><dt>VAT collected</dt><dd>@Display.Money(report.Summary.VatHalalas)</dd></div><div><dt>Average order (VAT included)</dt><dd>@Display.Money(report.Summary.AverageOrderHalalas)</dd></div></dl></section>}
<div class="overview-grid"><div class="overview-primary"><section class="panel rhythm-card"><div class="panel-heading"><div><h2>Sales Rhythm</h2><p>Completed sales including VAT · Asia/Riyadh</p></div><div class="chart-scope">@(report?.Granularity ?? "Unavailable") buckets</div></div>
@if(Model.Orders.Error is not null){<partial name="_ErrorNotice" model="Model.Orders.Error" />}
else if(report is null||report.Summary.CompletedOrders==0){<div class="empty chart-empty">No completed orders in this period.</div>}
else{<div class="rhythm-chart sales-chart"><svg viewBox="0 0 1000 220" role="img" aria-label="Completed SAR sales including VAT by store-local reporting period"><title>Sales Rhythm in Asia/Riyadh; maximum bucket @Display.Money(max)</title><line x1="20" y1="170" x2="980" y2="170" class="sales-axis" />
@for(int i=0;i<buckets.Count;i++){var bucket=buckets[i];var width=940m/buckets.Count;var height=(decimal)bucket.RevenueHalalas/max*135;var x=30+i*width;var label=report.Granularity=="day"?bucket.Label[5..]:bucket.Label;
<g><title>@bucket.Label · @Display.Money(bucket.RevenueHalalas) · @bucket.CompletedOrders orders</title><rect class="sales-bar" x="@x.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)" y="@((170-height).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))" width="@Math.Max(1,width-5).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)" height="@height.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)" rx="3" />@if(i%Math.Max(1,(int)Math.Ceiling(buckets.Count/8m))==0){<g><text x="@x.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)" y="200">@label</text></g>}</g>}
</svg></div><details class="chart-values"><summary>View chart values</summary><table class="table"><thead><tr><th>Store-local period</th><th>Sales including VAT</th><th>Completed orders</th></tr></thead><tbody>@foreach(var bucket in buckets){<tr><td>@bucket.Label</td><td>@Display.Money(bucket.RevenueHalalas)</td><td>@bucket.CompletedOrders</td></tr>}</tbody></table></details>}
</section><section class="panel recent-orders"><div class="panel-heading"><div><h2>Recent Orders</h2><p>Latest transactions in the selected period</p></div><a asp-action="Orders">View all orders <span class="icon" aria-hidden="true">arrow_forward</span></a></div>
@if(Model.Orders.Error is not null) { <partial name="_ErrorNotice" model="Model.Orders.Error" /> }
else if(Model.Orders.Orders.Count == 0) { <div class="empty"><h3>No orders yet</h3><p>Completed POS sales will appear here.</p></div> }
else { <div class="table-responsive"><table class="table admin-table compact-table"><thead><tr><th>Order ID</th><th>Time (UTC)</th><th class="text-end">Total (SAR)</th><th class="text-center">Status</th></tr></thead><tbody>@foreach(var order in Model.Orders.Orders.Take(5)) { <tr><td><a asp-action="Order" asp-route-id="@order.Id">@order.OrderNumber</a></td><td>@order.CreatedAt.ToUniversalTime().ToString("HH:mm")</td><td class="text-end money">@Display.Money(order.PayableHalalas, order.Currency)</td><td class="text-center"><span class="stock-badge success">@order.Status</span></td></tr> }</tbody></table></div><partial name="_MobileOrders" model="Model.Orders.Orders.Take(5).ToList()" /> }
</section></div><section class="panel stock-watch"><div class="panel-heading"><h2><span class="icon" aria-hidden="true">notification_important</span>Low Stock Alerts</h2><a asp-action="Inventory">Manage Stock</a></div>
@if(Model.Catalog.Error is not null) { <partial name="_ErrorNotice" model="Model.Catalog.Error" /> }
else { var watch = Model.Catalog.AllProducts.Where(p => p.Stock <= 5).OrderBy(p => p.Stock).ThenBy(p=>p.Name).Take(4).ToList();
 if(watch.Count == 0) { <div class="empty"><h3>No stock alerts</h3><p>All catalog products have more than five units.</p></div> }
 foreach(var product in watch) { <a class="stock-item" asp-action="Product" asp-route-id="@product.Id"><div><strong>@product.Name</strong><small>Demo threshold: 5 units</small></div><span class="stock-badge @(product.Stock==0 ? "danger" : "warning")">@product.Stock left</span></a> }
}
<div class="panel-bottom"><a asp-action="Inventory" asp-route-stock="attention">View in Inventory <span class="icon" aria-hidden="true">chevron_right</span></a></div></section></div>
@if(report is not null){<div class="report-analytics"><section class="panel payment-breakdown"><div class="panel-heading"><h2>Payment Methods</h2></div>@foreach(var payment in report.PaymentMethods){<div class="analytics-row"><strong>@Display.Payment(payment.Method)</strong><span>@payment.CompletedOrders orders · @Display.Money(payment.RevenueHalalas) · @((payment.RevenueShare*100).ToString("0.0"))%</span></div>}<p class="data-scope">Simulated card sales are demo transactions, not bank settlements.</p></section><section class="panel top-products"><div class="panel-heading"><h2>Top-selling Products</h2></div>@if(report.TopProducts.Count==0){<p class="empty">No products sold in this period.</p>}@foreach(var product in report.TopProducts){<div class="analytics-row"><strong>@product.Name</strong><span>@product.UnitsSold units · @Display.Money(product.GrossHalalas)</span></div>}<p class="data-scope">Historical line-item sales before discounts and VAT.</p></section></div>}
<p class="data-scope">Sales use the selected Asia/Riyadh period and completed SAR snapshots. Inventory and catalog cards show current state.</p>
