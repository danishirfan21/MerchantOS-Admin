@model MerchantOS.Admin.Controllers.FactorModel
@{ Layout=null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify MFA · MerchantOS Admin</title><link rel="stylesheet" href="~/fonts/inter.css"><link rel="stylesheet" href="~/css/auth.css"></head><body><main><form asp-controller="Account" asp-action="Verify" method="post"><h1>@(Model.Enrollment ? "Set up your authenticator" : "Verify your identity")</h1><p>This restricted sign-in expires at @Model.ExpiresAt.ToUniversalTime().ToString("HH:mm 'UTC'"). No administrative access is available until verification succeeds.</p><div asp-validation-summary="All" role="alert"></div>
@if(Model.Secret is not null){<div class="enrollment-material" data-sensitive="true"><img class="mfa-qr" src="@Model.QrData" alt="Scan this private QR code with your authenticator"><label for="ManualKey">Manual setup key</label><code id="ManualKey">@Model.Secret</code></div><p>Add MerchantOS in a standard authenticator: time-based, six digits, SHA-1, 30 seconds. This key is shown once. Do not share it.</p>}
<label asp-for="Code">Authenticator code</label><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" autofocus>
@if(!Model.Enrollment){<label asp-for="RecoveryCode">Or one recovery code</label><input asp-for="RecoveryCode" autocomplete="off" spellcheck="false" maxlength="68"><p>Recovery codes are one-use second factors. They do not reset your password.</p>}
@if(Model.MustChangePassword){<p>Your temporary credential must be replaced before access is granted. Use 14–128 characters and a different password.</p><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="14" maxlength="128" required><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="14" maxlength="128" required>}
<button type="submit">Verify</button><button type="submit" asp-action="Cancel" formnovalidate class="secondary">Cancel sign-in</button></form></main></body></html>
