@model MerchantOS.Admin.Controllers.CodesModel
@{ Layout=null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Save recovery codes · MerchantOS Admin</title><link rel="stylesheet" href="~/fonts/inter.css"><link rel="stylesheet" href="~/css/auth.css"></head><body><main><section class="auth-card"><h1>Save your recovery codes</h1><p>Shown once. Keep these offline, separate from your password. Each code works once. Old codes are invalid after regeneration.</p><ol class="recovery-codes" data-sensitive="true">@foreach(var code in Model.Codes){<li><code>@code</code></li>}</ol><a class="continue" href="@Model.ReturnUrl">I saved my codes — continue</a><a href="/Account/Password">Manage account security</a></section></main></body></html>
